# Copy to `.env` (git-ignored) and adjust. Every variable is optional; the defaults suit local development.
# Real environment variables always win over values in `.env`.

# --- Web application ---------------------------------------------------------------------------
# Signs session cookies. REQUIRED in production (the built-in default is public).
INSPECTRA_SECRET=change-me
# Password for the `admin` account created on first start. Change it after the first login.
INSPECTRA_ADMIN_PW=change-me
# SQLite file (default: <repo>/inspectra.db)
# INSPECTRA_DB_PATH=/var/lib/inspectra/inspectra.db
# Insert demo inspectors/runs/fines into an EMPTY database (1 = yes, 0 = no)
INSPECTRA_SEED_DEMO=1
# Browsers drop Secure cookies on plain-http hosts other than localhost; use 0 only for LAN http testing.
INSPECTRA_COOKIE_SECURE=1
# Comma-separated origins allowed to call the API cross-origin. Empty = same-origin only (recommended).
# INSPECTRA_CORS_ORIGINS=https://dashboard.example.com
# Werkzeug debug mode allows remote code execution. Local development only.
INSPECTRA_DEBUG=0
# INSPECTRA_HOST=0.0.0.0
# PORT=5000
# INSPECTRA_LOG_LEVEL=INFO
# Failed logins per address + username before further attempts are refused, and for how long (seconds)
# INSPECTRA_LOGIN_MAX_FAILURES=5
# INSPECTRA_LOGIN_LOCKOUT_SECONDS=300
# Load the GTFS feed and routing engine in the background at startup (1) or on the first request (0)
# INSPECTRA_WARM_UP=1

# --- Live data: SIRI stop-monitoring proxy -----------------------------------------------------
INSPECTRA_SIRI_BASE_URL=https://raspberry-phy.taila18e05.ts.net
# Per request, in seconds
# INSPECTRA_SIRI_TIMEOUT_SECONDS=8
# INSPECTRA_SIRI_RETRY_DELAY_SECONDS=0.5
# How long a stop's answer is reused / how long a failing stop is left alone
# INSPECTRA_SIRI_CACHE_TTL_SECONDS=60
# INSPECTRA_SIRI_FAILURE_BACKOFF_SECONDS=15
# Stops queried in parallel, and the total time one recommendation waits for them
# INSPECTRA_SIRI_MAX_PARALLEL_FETCHES=8
# INSPECTRA_SIRI_REQUEST_BUDGET_SECONDS=5
# Legacy names still read as fallbacks: SIRI_BASE_URL, SIRI_TIMEOUT_SECONDS, SIRI_RETRY_DELAY_SECONDS
